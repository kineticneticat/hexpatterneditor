{
	"name": "hexpattern-editor",
	"displayName": "Hexpattern Editor",
	"description": "Custom editor for *.hexpattern files",
	"version": "0.0.1",
	"publisher": "kineticcat_",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/kineticneticat/hexpatterneditor"
	},
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "hexpatterneditor.hexpattern",
				"displayName": "Hexpattern Editor",
				"selector": [
					{
						"filenamePattern": "*.hexpattern"
					}
				]
			}
		],
		"commands": [
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"watch": "tsc -w -p ./"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/node": "^22",
		"@types/vscode": "^1.100.0",
		"eslint": "^9.13.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}